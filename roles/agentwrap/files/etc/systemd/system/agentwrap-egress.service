[Unit]
Description=Initialize shared agentwrap egress namespace
After=network-online.target systemd-resolved.service
Wants=network-online.target
Requires=systemd-resolved.service

[Service]
Type=oneshot
ExecStart=/opt/agentwrap/bin/agentwrap-egress-init
ExecReload=/opt/agentwrap/bin/agentwrap-egress-reset
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
